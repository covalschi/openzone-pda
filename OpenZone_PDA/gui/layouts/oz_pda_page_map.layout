// Сторінка «Карта».
//
// Кладеться скриптом у PageHost меню (1045x414 одиниць розмітки).
// Імена читає OZ_PdaPageMap.c: Map, BtnMode, BtnModeText, BtnCenter,
// BtnCenterText, MapHint.

FrameWidgetClass OZ_PageMap {
 visible 1
 position 0 0
 size 1306 518
 hexactpos 1
 vexactpos 1
 hexactsize 1
