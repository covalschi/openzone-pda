  // Сама карта. Рушій малює її й веде масштаб та зсув САМ -- колесо й
  // перетягування працюють без жодного нашого коду. Наше -- лише позначки.
  //
  // clipchildren 1 обов'язковий: без нього карта малюється за межі свого
  // прямокутника й вилазить із-під рамки корпуса.
  MapWidgetClass Map {
   visible 1
   clipchildren 1
   inheritalpha 0
   position 0 0
   size 1306 430
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   priority 1
  }


