// КПК: корпус пристрою поверх приглушеного світу.
//
// Розміри в одиницях розмітки 1280x640 -- рівно 2:1, як і текстура корпуса
// (2048x1024). Інакше вирізу довелось би не збігтися з рамкою.
//
// КООРДИНАТИ ЕКРАНА ПРОДУБЛЬОВАНІ в tools/gen_oz_pda_bezel.py (SCR_*).
// Правити СИНХРОННО: розійдуться -- і живий інтерфейс поїде з-під рамки.
//   L 0.068 * 1280 = 87      T 0.105 * 640 = 67
//   W 0.864 * 1280 = 1106    H 0.690 * 640 = 442
//
// Імена віджетів читає OZ_PdaMenu.c: Backdrop, Device, Bezel, Screen,
// TabRail, PageHost, StatusLeft, StatusMid, StatusRight, LockPanel,
// LockLabel, LockDots, BtnClose.

FrameWidgetClass OZ_PdaRoot {
 visible 1
 ignorepointer 1
 position 0 0
 size 1 1
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 // ПРІОРИТЕТ ТУТ НЕ ПРОСТО ЧИСЛО. Виміряно на живому клієнті: якщо пріоритет
 // самого ItemPreviewWidget або будь-якого його предка завеликий, рушій
 // МОВЧКИ не малює модель -- ні помилки, ні порожнього віджета, ні сліду в
 // лозі; SetItem/GetItem при цьому відпрацьовують штатно. Межа міряна:
 // 256 малює, 300 уже ні; спочатку тут стояло 990, і прев'ю не було ніде.
 // Ваніль вище 151 не піднімається (inventory_new/medium/icon.layout).
 priority 2
 {
  // Світ лишається видимим і приглушеним: пристрій тримають у руках, а не
  // йдуть в іншу реальність.
  PanelWidgetClass Backdrop {
   visible 1
   ignorepointer 1
   color 0 0 0 0.55
   position 0 0
   size 1 1
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 1
   style rover_sim_colorable
  }

  FrameWidgetClass Device {
   visible 1
   ignorepointer 1
   halign center_ref
   valign center_ref
   position 0 0
   size 1280 640
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   priority 2
   {
