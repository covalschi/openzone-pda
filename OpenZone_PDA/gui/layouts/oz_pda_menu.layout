     hexactsize 1
     vexactsize 1
     // Виміряно на живому клієнті: color МНОЖИТЬ текстуру, і рушій виводить
     // її помітно світліше, ніж вона лежить на диску (схоже на подвійне
     // гамма-перетворення). Тому яскравість калібрується тут, а не
     // перегенерацією .paa: текстура на диску правильна -- (28,29,33).
     color 0.38 0.38 0.40 1
     priority 5
     image0 "OpenZone_PDA/gui/textures/oz_pda_bezel_ca.paa"
     // mode blend ОБОВ'ЯЗКОВИЙ. Без нього режим за замовчуванням ігнорує
     // альфу й підмішує картинку аддитивно: проріз стає непрозорим, а
     // графітовий корпус світлішає до сірого металу. Ваніль завжди ставить
     // саме blend для прозорих картинок і opaque для фонів.
     mode blend
     "src alpha" 1
     // "stretch mode" ОБОВ'ЯЗКОВИЙ. Без нього віджет не масштабує текстуру, а
     // ОБРІЗАЄ її: видно рівно стільки, скільки вміщується, тобто лівий верхній
     // кут. Симптом на живому клієнті був саме такий -- верхня й ліва частини
     // рамки малювались, права й нижня зникали. Ваніль ставить те саме на
     // повноекранному фоні (day_z_title_screen.layout).
     //
     // Віджет 1280x640 і текстура 2048x1024 -- обидва рівно 2:1, тож
     // stretch_w_h не спотворює нічого.
     "stretch mode" stretch_w_h
    }

    // Кнопка закриття лежить ПОВЕРХ корпуса, у правому верхньому куті рамки.
    ButtonWidgetClass BtnClose {
     visible 1
     halign right_ref
     position 18 14
     size 34 34
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     priority 6
     text ""
     style "DayZButton"
    }
   }
  }
 }
}
