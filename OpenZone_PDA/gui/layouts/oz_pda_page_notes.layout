   lines 14
   font "gui/fonts/sdf_MetronBook24"
   "exact text" 1
   "exact text size" 14
   color 0.788 0.788 0.816 1
   priority 2
  }

  // БЕЗ style "DayZButton": стиль малює власну графіку ПОВЕРХ дочірніх
  // віджетів, і напис усередині зникає.
  ButtonWidgetClass BtnNew {
   visible 1
   position 16 376
   size 340 26
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   text ""
   priority 3
