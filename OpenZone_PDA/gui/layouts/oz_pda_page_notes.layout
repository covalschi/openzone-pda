     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     color 1 0.478 0.102 1
     text ""
     font "gui/fonts/sdf_MetronBook24"
     "exact text" 1
     "exact text size" 13
     "text halign" center
     "text valign" center
     priority 2
    }
   }
  }

