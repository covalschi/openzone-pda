    }

    // Той самий віджет, яким ваниль дає писати на папері
    // (gui/layouts/day_z_inventory_note.layout). Клавіатуру він ловить сам --
    // на відміну від OnKeyPress меню, куди ввід доходить не з усякого джерела.
    MultilineEditBoxWidgetClass NoteBody {
     visible 1
