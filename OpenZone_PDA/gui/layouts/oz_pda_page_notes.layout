// Сторінка «Записки»: список ліворуч, редактор праворуч.
//
// Кладеться скриптом у PageHost меню (1045x414 одиниць розмітки).
// Імена читає OZ_PdaPageNotes.c: NoteList, BtnNew, BtnNewText, NoteTitle,
// NoteBody, BtnSave, BtnSaveText, BtnDelete, BtnDeleteText, NotesHint.

FrameWidgetClass OZ_PageNotes {
 visible 1
 position 0 0
 size 1045 414
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 {
  // --- ліва колонка: перелік ---

  // Невидима лінійка розклейки переносів: ТОЙ САМИЙ шрифт, що в полі, бо
  // мірятись чужим шрифтом означало б брехати на кожній літері.
  TextWidgetClass WrapRuler {
   visible 0
   ignorepointer 1
   position 0 0
   size 10 10
   color 1 1 1 1
   text ""
   font "gui/fonts/MetronBook14"
   "exact text" 1
  }
