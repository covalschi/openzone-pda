     position 0 0
     size 340 26
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     priority 1
     style rover_sim_colorable
    }
    TextWidgetClass BtnNewText {
     visible 1
     ignorepointer 1
     position 0 0
