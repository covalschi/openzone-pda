// Рядок переліку записок. Кнопка: клік відкриває, акцентна назва каже
// «натисни», дата праворуч. Кладеться скриптом у канву NotesCanvas.
ButtonWidgetClass OZ_NoteRow {
 visible 1
 position 0 0
 size 340 26
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 text ""
 priority 2
 {
  PanelWidgetClass RowPick {
   visible 0
   ignorepointer 1
   color 1 0.478 0.102 1
   position 0 3
   size 2 20
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   priority 1
  }

  TextWidgetClass RowTitle {
   visible 1
   ignorepointer 1
   position 8 0
   size 228 26
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   color 1 0.478 0.102 1
   text ""
   font "gui/fonts/MetronBook14"
   "exact text" 1
   "text halign" left
   "text valign" center
   priority 1
  }

  TextWidgetClass RowDate {
   visible 1
   ignorepointer 1
   position 240 0
   size 76 26
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   color 0.55 0.55 0.58 1
   text ""
   font "gui/fonts/MetronBook14"
   "exact text" 1
   "text halign" right
   "text valign" center
   priority 1
  }
 }
}
