// Сторінка «Контакти»: хто зараз у Зоні.
//
// Кладеться скриптом у PageHost меню (1306x518 одиниць розмітки). Контакти
// й фракція тепер одна вкладка, поділена навпіл: контакти займають ЛІВУ
// половину і не виходять за x = 620, права належить фракції.
// Імена читає OZ_PdaPageContacts.c: ContactsHeader, ContactList,
// ContactsHint, BtnHide, BtnHideText.

FrameWidgetClass OZ_PageContacts {
 visible 1
 position 0 0
 size 1306 518
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 {
  TextWidgetClass ContactsHeader {
   visible 1
   ignorepointer 1
   position 20 15
   size 380 28
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   color 1 0.478 0.102 1
   text ""
   font "gui/fonts/sdf_MetronBook24"
   "exact text" 1
   "exact text size" 16
   "text halign" left
   "text valign" center
   priority 2
  }

  // БЕЗ style "DayZButton": стиль малює власну графіку ПОВЕРХ дочірніх
  // віджетів, і напис усередині зникає.
  ButtonWidgetClass BtnHide {
   visible 1
   position 420 14
   size 200 30
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   text ""
   priority 3
   {
    PanelWidgetClass BtnHideBg {
     visible 1
     ignorepointer 1
     color 0.145 0.145 0.161 1
     position 0 0
     size 200 30
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     priority 1
     style rover_sim_colorable
    }
    TextWidgetClass BtnHideText {
     visible 1
     ignorepointer 1
     position 0 0
     size 200 30
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     color 1 0.478 0.102 1
     text ""
     font "gui/fonts/sdf_MetronBook24"
     "exact text" 1
     "exact text size" 13
     "text halign" center
     "text valign" center
     priority 2
    }
   }
  }

  // Написати обраному контакту. Лише контакту: чат починається з рукостискання.
  ButtonWidgetClass BtnMsg {
   visible 0
   position 20 482
   size 285 30
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   text ""
   priority 3
   {
    PanelWidgetClass BtnMsgBg {
     visible 1
     ignorepointer 1
     color 0.145 0.145 0.161 1
     position 0 0
     size 285 30
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     priority 1
     style rover_sim_colorable
    }
    TextWidgetClass BtnMsgText {
     visible 1
     ignorepointer 1
     position 0 0
     size 285 30
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     color 1 0.478 0.102 1
     text ""
     font "gui/fonts/sdf_MetronBook24"
     "exact text" 1
     "exact text size" 13
     "text halign" center
     "text valign" center
     priority 2
    }
   }
  }

  // Дія над обраним рядком. Що саме вона робить -- залежить від стосунків,
  // і напис на ній це каже: просити, прийняти, відмовити, викреслити.
  ButtonWidgetClass BtnFriend {
   visible 1
   position 335 482
   size 285 30
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   text ""
   priority 3
   {
    PanelWidgetClass BtnFriendBg {
     visible 1
     ignorepointer 1
     color 0.145 0.145 0.161 1
     position 0 0
     size 285 30
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     priority 1
     style rover_sim_colorable
    }
    TextWidgetClass BtnFriendText {
     visible 1
     ignorepointer 1
     position 0 0
     size 285 30
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     color 1 0.478 0.102 1
     text ""
     font "gui/fonts/sdf_MetronBook24"
     "exact text" 1
     "exact text size" 13
     "text halign" center
     "text valign" center
     priority 2
    }
   }
  }

  // "colums" -- саме так, з одним m: помилка в самому рушії, і виправляти її
  // тут означає лишитись без колонок. "lines" обов'язковий.
  // Список -- ПРОКРУТКА з рядками, а не TextListbox.
  //
  // Listbox уміє лише один рядок тексту на запис, і все про людину доводилось
  // зліплювати комами. Тепер кожен контакт -- власна розкладка
  // (oz_pda_contact_row.layout), і в ній є де показати ім'я, фракцію її
  // кольором, звання, посаду й мітки, не перетворюючи це на речення.
  ScrollWidgetClass ContactScroll {
   visible 1
   position 20 58
   size 600 395
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   "Scrollbar V" 1
   priority 2
   {
    WrapSpacerWidgetClass ContactList {
     visible 1
     position 0 0
     size 600 395
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 0
    }
   }
  }

  // Ширина 235 різала кожну підказку довшу за чотири слова -- «No contacts
  // yet. Meet somebody an». Тепер підказка бере всю ліву колонку -- 600
  // одиниць: кнопка «сховатись» переїхала нагору, в рядок заголовка, і поруч
  // із підказкою вже ніщо не тісниться.
  TextWidgetClass ContactsHint {
   visible 1
   ignorepointer 1
   halign left_ref
   position 20 458
   size 600 22
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   color 0.463 0.463 0.494 1
   text ""
   font "gui/fonts/sdf_MetronBook24"
   "exact text" 1
   "exact text size" 14
   "text halign" left
   "text valign" center
   priority 2
  }
 }
}
