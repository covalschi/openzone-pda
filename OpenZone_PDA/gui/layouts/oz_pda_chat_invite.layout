// Один ряд запрошення до групи: назва, від кого, ТАК/НІ.
// Створюється скриптом; імена кнопок він перезаписує на ключ групи,
// а UserID 6/7 відрізняє прийняття від відмови в OnClick.

PanelWidgetClass OZ_ChatInviteRow {
 visible 1
 position 0 0
 size 375 48
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 {
