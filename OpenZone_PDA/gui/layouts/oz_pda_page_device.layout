   size 320 382
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   priority 1
   style rover_sim_colorable
   {
    // Справжня 3D-модель предмета, яку рушій крутить сам. Єдине місце, де
    // модель у меню взагалі можлива: рендера в текстуру для віджетів немає,
    // а ItemPreviewWidget -- є.
    ItemPreviewWidgetClass Preview {
     visible 1
