     vexactsize 1
     color 1 0.478 0.102 1
     text ""
     font "gui/fonts/sdf_MetronBook24"
     "exact text" 1
     "exact text size" 19
     "text halign" left
     "text valign" center
     priority 3
    }
    TextWidgetClass TitleProfile {
