// Сторінка «Пристрій»: що це за КПК, чим живиться, що в нього вставлено.
//
// Кладеться скриптом у PageHost меню (1045x414 одиниць розмітки).
// Імена читає OZ_PdaPageDevice.c: Preview, TitleName, TitleProfile,
// ChargeLabel, ChargeBar, ChargeFill, BaySlot0..2, BayText0..2, CarrierText,
// SessionText, SnapshotText, PinText, AutoLockText, RadText.

FrameWidgetClass OZ_PageDevice {
 visible 1
 position 0 0
 size 1045 414
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 {
  // --- ліва колонка: сама річ ---
  PanelWidgetClass PreviewPane {
   visible 1
   ignorepointer 1
