// HUD КПК: смужка живлення, тост чату, мінімапа.
//
// Створюється ПРЯМО НА РОБОЧІЙ ОБЛАСТІ, повз меню -- живе, поки гравець
// ходить. Корінь на весь екран і прозорий: позиції трьох блоків незалежні,
// а ховаються вони поодинці (OZ_PdaHud вирішує, кому світитись).
//
// Імена читає OZ_PdaHud.c: StripPane, HudPower, ToastPane, ToastWho,
// ToastText, MiniPane, MiniMap.
//
// priority нижче 256: правило §13 зі скила діє на все дерево.

FrameWidgetClass OZ_PdaHudRoot {
 visible 0
 clipchildren 0
 inheritalpha 0
 ignorepointer 1
 position 0 0
 size 1 1
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 priority 8
 {
  // ------------------------------------------------------------- смужка
  FrameWidgetClass StripPane {
   visible 0
   ignorepointer 1
   position 0.845 0.845
   size 0.14 0.05
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 2
   {
    PanelWidgetClass HudBg {
     visible 1
     ignorepointer 1
     color 0.055 0.055 0.062 0.62
     position 0 0
     size 1 1
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     priority 1
     style rover_sim_colorable
    }

    // Оранжева риска ліворуч -- та сама, що на корпусі. Смужку впізнають по
    // ній, а не по тексту: текст на периферії зору не читають.
    PanelWidgetClass HudMark {
     visible 1
     ignorepointer 1
     color 1 0.478 0.102 1
     position 0 0
     size 3 1
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 0
     priority 2
     style rover_sim_colorable
    }

    TextWidgetClass HudPower {
     visible 1
     ignorepointer 1
     position 10 0
     size 1 1
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 0
     color 0.788 0.788 0.816 1
     text ""
     font "gui/fonts/sdf_MetronBook24"
     "exact text" 1
     "exact text size" 14
     "text halign" left
     "text valign" center
     priority 3
    }
   }
  }

  // -------------------------------------------------------------- тост
  //
  // Прийшло повідомлення, а меню закрите: пристрій «пікає» рядком над
  // смужкою. Показує ОСТАННЄ і кілька секунд -- це дзвінок, а не журнал.
  // Тост: заголовок «хто [канал]» і ДВА рядки тіла з переносом. Довше --
  // ріжеться по краю другого рядка; повний текст завжди у розмові.
  FrameWidgetClass ToastPane {
   visible 0
   ignorepointer 1
   position 0.655 0.825
   size 0.2 0.078
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 2
   {
    PanelWidgetClass ToastBg {
     visible 1
     ignorepointer 1
     color 0.055 0.055 0.062 0.72
     position 0 0
     size 1 1
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     priority 1
     style rover_sim_colorable
    }

    PanelWidgetClass ToastMark {
     visible 1
     ignorepointer 1
     color 1 0.478 0.102 1
     position 0 0
     size 3 1
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 0
     priority 2
     style rover_sim_colorable
    }

    TextWidgetClass ToastWho {
     visible 1
     ignorepointer 1
     position 10 4
     size 0.94 20
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 1
     color 1 0.478 0.102 1
     text ""
     font "gui/fonts/sdf_MetronBook24"
     "exact text" 1
     "exact text size" 12
     "text halign" left
     "text valign" center
     priority 3
    }

    MultilineTextWidgetClass ToastText {
     visible 1
     ignorepointer 1
     wrap 1
     position 10 26
     size 0.94 40
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 1
     color 0.788 0.788 0.816 1
     text ""
     font "gui/fonts/sdf_MetronBook24"
     "exact text" 1
     "exact text size" 13
     "text halign" left
     "text valign" top
     priority 3
    }
   }
  }

  // ----------------------------------------------------------- мінімапа
  //
  // MapWidget малює себе поверх власних дітей (зміряно, §19 скила), тому
  // рамка -- це ПІДКЛАДКА більшого розміру, а не накладка: мапа лежить у
  // ній із відступом, і край підкладки видно довкола.
  FrameWidgetClass MiniPane {
   visible 0
   ignorepointer 1
   position 0.845 0.6
   size 0.14 0.235
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 2
   {
    PanelWidgetClass MiniFrame {
     visible 1
     ignorepointer 1
     color 0.055 0.055 0.062 0.85
     position 0 0
     size 1 1
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     priority 1
     style rover_sim_colorable
    }

    MapWidgetClass MiniMap {
     visible 1
     clipchildren 1
     inheritalpha 0
     ignorepointer 1
     position 3 3
     size 0.985 0.885
     hexactpos 1
     vexactpos 1
     hexactsize 0
     vexactsize 0
     priority 2
    }

    TextWidgetClass MiniTrack {
     visible 0
     ignorepointer 1
     halign left
     valign bottom_ref
     position 6 4
     size 300 16
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     color 1 0.478 0.102 1
     text ""
     font "gui/fonts/sdf_MetronBook24"
     "exact text" 1
     "exact text size" 13
     "text halign" left
     "text valign" center
     priority 3
    }
   }
  }
 }
}
