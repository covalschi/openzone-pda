{
  "layout": "oz_pda_tab",
  "note": "Одна вкладка рельса: іконка, підпис, смуга активної, лічильник. Скрипт ставить ім'я сторінки (SetName), SetUserID(1), вантажить іконку в TabIcon і текст у TabLabel; TabActive/TabHover/TabMark/TabBadge вмикає сам.",
  "root": {"button": {"name": "OZ_PdaTab", "size": [60, "$size.tab"], "children": [
    {"panel": {"name": "TabActive", "size": "fill", "color": "$pick", "hidden": true, "priority": 1}},
    {"panel": {"name": "TabHover", "size": "fill", "color": "$hover", "hidden": true, "priority": 2}},
    {"panel": {"name": "TabMark", "size": [3, "$size.tab"], "color": "$accent", "hidden": true, "priority": 3}},
    {"icon":  {"name": "TabIcon", "at": [17, 8], "size": [26, 26], "image": "tab_page", "color": "$muted", "priority": 3}},
    {"label": {"name": "TabLabel", "at": [0, 38], "w": "fill", "h": 16, "font": "tiny", "color": "$muted", "align": "center", "priority": 3}},
    {"badge": {"name": "TabBadge", "anchor": "right", "at": [4, 4], "size": [16, 16], "priority": 4}}
  ]}}
}
